          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed CITIZEN to speak",
            "time": "2:02:47 PM",
            "_id": "697b1b2f57d08be1bdc00a8f"
          },
          {
            "sender": "citizen",
            "text": "Thank you, Your Honor. I moved out on Dec 31st. I left the place spotless. I have photos taken an hour before I handed over the keys.",
            "time": "2:02:53 PM",
            "_id": "697b1b3557d08be1bdc00a9a"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed OPPONENT to speak",
            "time": "2:03:38 PM",
            "_id": "697b1b6257d08be1bdc00aa6"
          },
          {
            "sender": "opponent",
            "text": "My client, the landlord, had to repaint the entire living room because of \"excessive scuffing.\" That cost $1,200 alone. Here are the invoices.",
            "time": "2:03:44 PM",
            "_id": "697b1b6857d08be1bdc00ab3"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed POLICE to speak",
            "time": "2:04:35 PM",
            "_id": "697b1b9b57d08be1bdc00ac1"
          },
          {
            "sender": "police",
            "text": "Your Honor, I am submitting the move-out inspection report filed by the local housing authority into the record.",
            "time": "2:04:43 PM",
            "_id": "697b1ba357d08be1bdc00ad0"
          },
          {
            "sender": "judge",
            "text": "Police, does that report mention wall damage?",
            "time": "2:05:09 PM",
            "_id": "697b1bbd57d08be1bdc00ae0"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed POLICE to speak",
            "time": "2:05:30 PM",
            "_id": "697b1bd257d08be1bdc00af1"
          },
          {
            "sender": "police",
            "text": "It mentions \"standard wear and tear consistent with three years of residency,\" Your Honor.",
            "time": "2:05:37 PM",
            "_id": "697b1bd957d08be1bdc00b03"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed CITIZEN to speak",
            "time": "2:06:00 PM",
            "_id": "697b1bf057d08be1bdc00b16"
          },
          {
            "sender": "citizen",
            "text": "Exactly! I lived there for three years. A few marks are normal.",
            "time": "2:06:04 PM",
            "_id": "697b1bf457d08be1bdc00b2a"
