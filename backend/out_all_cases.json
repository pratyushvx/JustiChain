          },
          {
            "sender": "SYSTEM",
            "text": "OPPONENT joined the courtroom",
            "time": "11:45:16 AM",
            "_id": "697afaf49989350239db3a33"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed OPPONENT to speak",
            "time": "11:47:07 AM",
            "_id": "697afb639989350239db3a4a"
          },
          {
            "sender": "opponent",
            "text": "Claimed their internal team found \"moisture indicators\" tripped, suggesting liquid damage.",
            "time": "11:47:16 AM",
            "_id": "697afb6c9989350239db3a62"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed LAWYER to speak",
            "time": "11:47:35 AM",
            "_id": "697afb7f9989350239db3a7b"
          },
          {
            "sender": "lawyer",
            "text": "Produced a time-stamped video of the unboxing and the initial failure, showing no liquid contact. They also highlighted that the authorized service center's initial report made no mention of moisture.",
            "time": "11:47:41 AM",
            "_id": "697afb859989350239db3a95"
          },
          {
            "sender": "judge",
            "text": "Dismissed the Opponent’s \"moisture\" claim as inconsistent with the primary evidence. Ordered a final settlement proposal.",
            "time": "11:48:02 AM",
            "_id": "697afb9a9989350239db3ab0"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed OPPONENT to speak",
            "time": "11:48:21 AM",
            "_id": "697afbad9989350239db3acc"
          },
          {
            "sender": "opponent",
            "text": "Offered a replacement unit but refused a refund.",
            "time": "11:48:27 AM",
            "_id": "697afbb39989350239db3ae9"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge allowed CITIZEN to speak",
            "time": "11:48:43 AM",
            "_id": "697afbc39989350239db3b07"
          },
          {
            "sender": "citizen",
            "text": "Rejected the replacement, citing a loss of faith in the brand and the retailer's \"bad faith\" delay tactics.",
            "time": "11:48:55 AM",
            "_id": "697afbcf9989350239db3b26"
          },
          {
            "sender": "SYSTEM",
            "text": "Judge muted everyone",
            "time": "11:49:12 AM",
            "_id": "697afbe09989350239db3b46"
          },
          {
            "sender": "judge",
            "text": "The Court finds Global Electronics Retailers Ltd. liable for selling a defective product and attempting to mislead the court with inconsistent technical reports.",
            "time": "11:49:39 AM",
            "_id": "697afbfb9989350239db3b67"
          }
        ],
        "courtRoomId": "COURT_1769667207970",
        "closedAt": "2026-01-29T06:19:50.036Z",
